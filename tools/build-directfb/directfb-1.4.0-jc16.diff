+/*
+ * ROTATION (Prime GO): software-rotate the logical layer surface into the
+ * physical framebuffer layout.
+ *
+ *   src  : logical surface buffer, sw x sh pixels, spitch bytes/row
+ *   dst  : physical fb buffer, fw x fh pixels, fpitch bytes/row
+ *   deg  : 90 = left (CCW), 270 = right (CW), 180 = upside down
+ *
+ * Uses the process-global scratch buffer (shared->rot_scratch) so the
+ * in-place rotation is safe. 32bpp only.
+ */
+/* convert RGB565 -> RGB32 (single pixel) */
+static inline unsigned int
+rgb565_to_rgb32( unsigned int px )
+{
+     unsigned int r = (px >> 11) & 0x1f;
+     unsigned int g = (px >> 5)  & 0x3f;
+     unsigned int b = px & 0x1f;
+     r = (r << 3) | (r >> 2);
+     g = (g << 2) | (g >> 4);
+     b = (b << 3) | (b >> 2);
+     return 0xff000000 | (r << 16) | (g << 8) | b;
+}
+
+static void
+fbdev_rotate_primary( unsigned char *src, int sw, int sh, int spitch,
+                      unsigned char *dst, int fw, int fh, int fpitch,
+                      int deg )
+{
+     FBDevShared *shared = dfb_fbdev->shared;
+     unsigned char *scratch = shared->rot_scratch;
+     unsigned int   x, y;
+     int src_bpp = (shared->rot_src_bpp >= 2) ? shared->rot_src_bpp : 4;
+
+     if (!scratch || !src || !dst)
+          return;
+
+     /* copy the whole logical buffer to scratch first (safe in-place) */
+     memcpy( scratch, src, (size_t)sh * spitch );
+
+     if (src_bpp == 2) {
+          /* RGB16 source -> RGB32 fb: convert while rotating */
+          for (y = 0; y < (unsigned)sh; y++) {
+               const unsigned short *srow = (const unsigned short *)(scratch + y * spitch);
+               for (x = 0; x < (unsigned)sw; x++) {
+                    unsigned int *dp;
+                    unsigned int  px = rgb565_to_rgb32( srow[x] );
+                    switch (deg) {
+                    case 90:
+                         dp = (unsigned int *)(dst + (sw - 1 - x) * fpitch + y * 4);
+                         break;
+                    case 270:
+                         dp = (unsigned int *)(dst + x * fpitch + (fw - 1 - y) * 4);
+                         break;
+                    case 180:
+                         dp = (unsigned int *)(dst + (sh - 1 - y) * fpitch + (sw - 1 - x) * 4);
+                         break;
+                    default:
+                         dp = (unsigned int *)(dst + y * fpitch + x * 4);
+                         break;
+                    }
+                    dp[0] = px;
+               }
+          }
+          return;
+     }
+
+     switch (deg) {
+     case 90: /* left / counter-clockwise: dst(y, sw-1-x) = src(x,y) */
+          for (y = 0; y < (unsigned)sh; y++) {
+               const unsigned int *srow = (const unsigned int *)(scratch + y * spitch);
+               for (x = 0; x < (unsigned)sw; x++) {
+                    unsigned int *dp = (unsigned int *)(dst + (sw - 1 - x) * fpitch + y * 4);
+                    dp[0] = srow[x];
+               }
+          }
+          break;
+     case 270: /* right / clockwise: dst(x, fw-1-y) = src(x,y) */
+          for (y = 0; y < (unsigned)sh; y++) {
+               const unsigned int *srow = (const unsigned int *)(scratch + y * spitch);
+               for (x = 0; x < (unsigned)sw; x++) {
+                    unsigned int *dp = (unsigned int *)(dst + x * fpitch + (fw - 1 - y) * 4);
+                    dp[0] = srow[x];
+               }
+          }
+          break;
+     case 180:
+          for (y = 0; y < (unsigned)sh; y++) {
+               const unsigned int *srow = (const unsigned int *)(scratch + y * spitch);
+               for (x = 0; x < (unsigned)sw; x++) {
+                    unsigned int *dp = (unsigned int *)(dst + (sh - 1 - y) * fpitch + (sw - 1 - x) * 4);
+                    dp[0] = srow[x];
+               }
+          }
+          break;
+     default: /* no rotation: plain copy */
+          memcpy( dst, scratch, (size_t)sh * spitch );
+          break;
+     }
+}
+
 FBDev *dfb_fbdev = NULL;
 
